# ── Anthropic ──────────────────────────────────────────────
# Récupérer sur : console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# ── Notion ─────────────────────────────────────────────────
# Intégration Notion → récupérer sur : notion.so/my-integrations
# (déjà utilisée par les autres outils du projet)
NOTION_TOKEN=secret_...

# ── Gmail (App Password) ────────────────────────────────────
# Adresse Gmail / Google Workspace utilisée pour l'envoi
GMAIL_USER=bonjour@eneko-formation.fr
# Mot de passe d'application généré par Google (voir README)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Upstash Redis (rate-limit distribué, optionnel) ─────────
# Console Upstash → votre base Redis → onglet "REST API"
# Sans ces variables, le rate-limit retombe sur un compteur en
# mémoire d'instance (efficace mais non partagé entre instances).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
